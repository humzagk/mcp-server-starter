{
  "name": "mcp-server-starter",
  "version": "0.1.0",
  "description": "A production-minded MCP server template: plug in an adapter for your product and expose search, read and (opt-in) write tools to AI assistants over stdio or HTTP.",
  "type": "module",
  "license": "MIT",
  "author": "Humza Gohar Kabir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humzagk/mcp-server-starter.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "template",
    "claude",
    "ai-agents",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "bin": {
    "mcp-server-starter": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
